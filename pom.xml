<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.agrovalle</groupId>
	<artifactId>Proyecto-AgroValle</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>AgroValle Connect</name>
	<description>Plataforma web (Java 17 / Spring Boot) que conecta la oferta agrícola del Valle del Cauca con la demanda comercial urbana, eliminando intermediación innecesaria.</description>
	<url>https://github.com/JhonRivas1788/Proyecto-AgroValle</url>
	<developers>
		<developer>
			<name>Jhon Stiven Rivas Angulo</name>
			<id>JhonRivas1788</id>
			<roles><role>Scrum Master</role></roles>
		</developer>
		<developer>
			<name>Reinaldo Daniel Niño Belalcazar</name>
			<id>rdninoEstudiante</id>
			<roles><role>Product Owner</role></roles>
		</developer>
		<developer>
			<name>Kevin Andres Rosero Mestizo</name>
			<id>KevinnRosero</id>
			<roles><role>Developer</role></roles>
		</developer>
		<developer>
			<name>Luis Eduardo Vera Orejuela</name>
			<id>leduardovera</id>
			<roles><role>Developer</role></roles>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:git@github.com:JhonRivas1788/Proyecto-AgroValle.git</connection>
		<developerConnection>scm:git:git@github.com:JhonRivas1788/Proyecto-AgroValle.git</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/JhonRivas1788/Proyecto-AgroValle</url>
	</scm>
	<properties>
		<java.version>17</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Checkstyle: cero advertencias de estilo (Google Java Style) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>3.3.1</version>
				<configuration>
					<configLocation>checkstyle.xml</configLocation>
					<encoding>UTF-8</encoding>
					<consoleOutput>true</consoleOutput>
					<failsOnError>true</failsOnError>
					<violationSeverity>warning</violationSeverity>
				</configuration>
				<executions>
					<execution>
						<id>checkstyle-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- JaCoCo: cobertura mínima del 60% exigida por el DoD -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.12</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.60</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
